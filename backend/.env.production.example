# =============================================================================
# ChamberForge — Production Environment Configuration
# =============================================================================
# Copy to .env on your production server and fill in real values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_PORT=8000
FRONTEND_URL=https://app.chamberforge.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://chamberforge:STRONG_PASSWORD_HERE@prod-db-host:5432/chamberforge

# --- Redis ---
REDIS_URL=redis://:REDIS_PASSWORD_HERE@prod-redis-host:6379/0

# --- Authentication ---
JWT_SECRET=GENERATE_A_STRONG_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Sentry (Error Tracking) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Anthropic (AI Core) ---
ANTHROPIC_API_KEY=sk-ant-api03-PRODUCTION_KEY_HERE
AI_MODEL=claude-sonnet-4-6

# --- AWS S3 (Document Storage) ---
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=chamberforge-prod-documents
AWS_REGION=us-east-1

# --- Elasticsearch ---
ELASTICSEARCH_URL=https://prod-elasticsearch-host:9200

# --- Stripe (Billing) ---
STRIPE_SECRET_KEY=sk_live_PRODUCTION_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_PRODUCTION_SECRET_HERE

# --- Resend (Transactional Email) ---
RESEND_API_KEY=re_PRODUCTION_KEY_HERE

# --- Pusher (Realtime Notifications) ---
PUSHER_APP_ID=YOUR_PROD_APP_ID
PUSHER_KEY=YOUR_PROD_PUSHER_KEY
PUSHER_SECRET=YOUR_PROD_PUSHER_SECRET
PUSHER_CLUSTER=us2

# --- VoiceForge Integration ---
VOICEFORGE_API_URL=https://api.voiceforge.ai/v1
VOICEFORGE_API_KEY=vf_PRODUCTION_KEY_HERE

# --- VisionAudioForge Integration ---
VISIONAUDIOFORGE_API_URL=https://api.visionaudioforge.ai/v1
VISIONAUDIOFORGE_API_KEY=vaf_PRODUCTION_KEY_HERE
