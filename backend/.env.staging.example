# =============================================================================
# ChamberForge — Staging Environment Configuration
# =============================================================================
# Copy to .env on your staging server and fill in real values.
# Uses test/sandbox keys for all third-party services.
# =============================================================================

# --- Application ---
APP_ENV=staging
APP_PORT=8000
FRONTEND_URL=https://staging.chamberforge.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://chamberforge:STAGING_PASSWORD_HERE@staging-db-host:5432/chamberforge_staging

# --- Redis ---
REDIS_URL=redis://:STAGING_REDIS_PASSWORD@staging-redis-host:6379/0

# --- Authentication ---
JWT_SECRET=STAGING_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Sentry (Error Tracking) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Anthropic (AI Core) ---
ANTHROPIC_API_KEY=sk-ant-api03-STAGING_KEY_HERE
AI_MODEL=claude-sonnet-4-6

# --- AWS S3 (Document Storage) ---
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=chamberforge-staging-documents
AWS_REGION=us-east-1

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://staging-elasticsearch-host:9200

# --- Stripe (Billing — TEST MODE) ---
STRIPE_SECRET_KEY=sk_test_STAGING_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_STAGING_SECRET_HERE

# --- Resend (Transactional Email) ---
RESEND_API_KEY=re_STAGING_KEY_HERE

# --- Pusher (Realtime Notifications) ---
PUSHER_APP_ID=YOUR_STAGING_APP_ID
PUSHER_KEY=YOUR_STAGING_PUSHER_KEY
PUSHER_SECRET=YOUR_STAGING_PUSHER_SECRET
PUSHER_CLUSTER=us2

# --- VoiceForge Integration ---
VOICEFORGE_API_URL=https://staging-api.voiceforge.ai/v1
VOICEFORGE_API_KEY=vf_STAGING_KEY_HERE

# --- VisionAudioForge Integration ---
VISIONAUDIOFORGE_API_URL=https://staging-api.visionaudioforge.ai/v1
VISIONAUDIOFORGE_API_KEY=vaf_STAGING_KEY_HERE
