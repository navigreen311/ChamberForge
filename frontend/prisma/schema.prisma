generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("operator")
  theme         String    @default("dark")
  mode          String    @default("expert")
  onboardedAt   DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id              String         @id @default(cuid())
  userId          String
  name            String
  company         String
  tier            String         @default("HNW")
  status          String         @default("prospect")
  healthScore     Int?
  healthTrend     Int?
  monthlyRetainer Int?
  renewalDate     DateTime?
  trustChannel    String?
  painCategories  String[]
  lastContactAt   DateTime?
  lastContactType String?
  onboardedAt     DateTime?
  offers          Offer[]
  wealthEvents    WealthEvent[]
  deliverables    Deliverable[]
  tasks           Task[]
  notifications   Notification[]
  createdAt       DateTime       @default(now())
}

model Problem {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?  @db.Text
  painCategory    String
  wealthTier      String
  buyerType       String?
  lifecycleStage  String   @default("Emerging")
  urgencyScore    Float    @default(5)
  credibilityScore Float   @default(5)
  wtpSignal       Float    @default(5)
  compositeScore  Float    @default(5)
  wtpRange        String?
  citations       Int      @default(0)
  status          String   @default("active")
  complianceRisk  String   @default("none")
  qualificationStatus String?
  createdAt       DateTime @default(now())
}

model Offer {
  id              String   @id @default(cuid())
  userId          String
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  problemId       String?
  playbookId      String?
  name            String
  tagline         String?
  deliverables    Json     @default("[]")
  priceMin        Int?
  priceMax        Int?
  pricingModel    String   @default("retainer")
  deliveryModel   String   @default("solo")
  kpis            Json     @default("[]")
  status          String   @default("draft")
  healthScore     Int?
  healthTrend     Int?
  renewalDate     DateTime?
  stripePriceId   String?
  createdAt       DateTime @default(now())
}

model Playbook {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  category        String
  targetBuyer     String
  corePain        String   @db.Text
  wealthTier      String[]
  deliveryModel   String
  pricingModel    String
  priceMin        Int
  priceMax        Int
  lifecycleStage  String   @default("Emerging")
  evidenceScore   Float    @default(5)
  wtpScore        Float    @default(5)
  activationMins  Int      @default(45)
  redTeamStatus   String   @default("not_run")
  readinessPct    Int      @default(50)
  voiceforgeReady Boolean  @default(false)
  visionAudioReady Boolean @default(false)
  dealDeskReady   Boolean  @default(false)
  trustPackReady  Boolean  @default(false)
  kpiCount        Int      @default(0)
  complianceRisk  String   @default("none")
  activeDeployments Int    @default(0)
  isTemplate      Boolean  @default(true)
  isCustom        Boolean  @default(false)
  isComposite     Boolean  @default(false)
  composedFrom    String[]
  citations       Citation[]
  createdAt       DateTime @default(now())
}

model Citation {
  id          String   @id @default(cuid())
  playbookId  String
  sourceType  String
  sourceName  String
  claim       String   @db.Text
  credibility Float
  playbook    Playbook @relation(fields: [playbookId], references: [id])
}

model Deliverable {
  id              String    @id @default(cuid())
  userId          String
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  name            String
  type            String
  status          String    @default("in_progress")
  priority        String    @default("medium")
  slaDate         DateTime
  deliveredAt     DateTime?
  assignee        String?
  qaScore         Int       @default(0)
  qaTotal         Int       @default(4)
  portalStatus    String    @default("not_sent")
  createdAt       DateTime  @default(now())
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  name        String
  priority    String    @default("medium")
  dueAt       DateTime
  completedAt DateTime?
  isRecurring Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
}

model WealthEvent {
  id          String   @id @default(cuid())
  userId      String
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  type        String
  description String   @db.Text
  personName  String?
  detectedAt  DateTime @default(now())
}

model RiskReviewItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String    @db.Text
  type        String
  sourceModule String
  riskLevel   String    @default("medium")
  status      String    @default("pending")
  reviewer    String?
  reviewNotes String?   @db.Text
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  type      String
  title     String
  body      String   @db.Text
  entityUrl String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
