# =============================================================================
# ChamberForge Frontend — Production Environment
# =============================================================================
# Copy to .env.local on your production deployment and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# --- API ---
NEXT_PUBLIC_API_URL=https://api.chamberforge.com

# --- NextAuth ---
NEXTAUTH_URL=https://app.chamberforge.com
NEXTAUTH_SECRET=GENERATE_A_STRONG_SECRET_HERE

# --- Pusher (Realtime) ---
NEXT_PUBLIC_PUSHER_KEY=your_production_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# --- Stripe (Client-side) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_PRODUCTION_KEY_HERE

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_VISION=true
