# ChamberForge Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/chamberforge

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Anthropic (AI Core)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
AI_MODEL=claude-sonnet-4-6

# AWS S3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_S3_BUCKET=YOUR_S3_BUCKET_HERE
AWS_REGION=us-east-1

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Stripe
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Resend (Email)
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Pusher (Realtime)
PUSHER_APP_ID=YOUR_PUSHER_APP_ID_HERE
PUSHER_KEY=YOUR_PUSHER_KEY_HERE
PUSHER_SECRET=YOUR_PUSHER_SECRET_HERE
PUSHER_CLUSTER=YOUR_PUSHER_CLUSTER_HERE

# VoiceForge Integration
VOICEFORGE_API_URL=YOUR_VOICEFORGE_API_URL_HERE
VOICEFORGE_API_KEY=YOUR_VOICEFORGE_API_KEY_HERE

# VisionAudioForge Integration
VISIONAUDIOFORGE_API_URL=YOUR_VISIONAUDIOFORGE_API_URL_HERE
VISIONAUDIOFORGE_API_KEY=YOUR_VISIONAUDIOFORGE_API_KEY_HERE
