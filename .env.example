# =============================================================================
# ChamberForge — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Never commit .env to version control.
# =============================================================================

# --- Application ---
# Environment: development | staging | production
APP_ENV=development
# Backend port
APP_PORT=8000
# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://chamberforge:localdev@localhost:5432/chamberforge

# --- Redis ---
# Used for caching, rate limiting, and job queues
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# NextAuth secret for frontend session encryption
NEXTAUTH_SECRET=generate-a-random-secret-here
# NextAuth canonical URL
NEXTAUTH_URL=http://localhost:3000
# JWT secret for backend API tokens (use a different value than NEXTAUTH_SECRET)
JWT_SECRET=generate-a-different-random-secret-here
# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256
# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Sentry (Error Tracking) ---
# Leave empty to disable Sentry
SENTRY_DSN=

# --- Anthropic (AI Core) ---
# Required for all AI-powered features (discovery, qualify, build, sell, command)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
# Model to use for AI operations
AI_MODEL=claude-sonnet-4-6

# --- AWS S3 (Document Storage) ---
# Used for file uploads, exports, and document storage
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_S3_BUCKET=chamberforge-dev-documents
AWS_REGION=us-east-1

# --- Elasticsearch ---
# Powers the global search feature
ELASTICSEARCH_URL=http://localhost:9200

# --- Stripe (Billing & Payments) ---
# Use sk_test_ keys for development
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
# Webhook signing secret from Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# --- Resend (Transactional Email) ---
# Used for sending emails (onboarding, notifications, etc.)
RESEND_API_KEY=re_YOUR_KEY_HERE

# --- Pusher (Realtime Notifications) ---
# Powers live notifications and real-time updates in the frontend
PUSHER_APP_ID=YOUR_APP_ID
PUSHER_KEY=YOUR_PUSHER_KEY
PUSHER_SECRET=YOUR_PUSHER_SECRET
PUSHER_CLUSTER=us2

# --- Datadog (APM & Monitoring) ---
# Required for production tracing, metrics, and dashboards
DD_API_KEY=
# Hostname where the Datadog Agent is running
DD_AGENT_HOST=localhost
# Environment tag sent with all traces and metrics
DD_ENV=development

# --- VoiceForge Integration ---
# Voice AI features: persona simulation, call analysis, voice training
VOICEFORGE_API_URL=http://localhost:9001
VOICEFORGE_API_KEY=YOUR_VOICEFORGE_KEY_HERE

# --- VisionAudioForge Integration ---
# Visual/audio AI features: reports, dashboards, video generation
VISIONAUDIOFORGE_API_URL=http://localhost:9002
VISIONAUDIOFORGE_API_KEY=YOUR_VISIONAUDIOFORGE_KEY_HERE

# --- CDN & Domain ---
# CloudFront CDN URL for static asset delivery (used as Next.js assetPrefix)
CDN_URL=https://cdn.chamberforge.com
# Custom domain for the platform
CUSTOM_DOMAIN=chamberforge.com
